+def _fallback_fused_decode_warmup_rows(
+    *,
+    topk: int,
+    num_heads: int,
+    max_pages: int,
+) -> tuple[int, ...]:
+    if int(max_pages) <= 0:
+        return ()
+
+    rows = {1, 2, 4}
+    if int(topk) == 512 and int(num_heads) == 64:
+        # DeepSeek/C4 shape: b12x keeps optimized decode variants through
+        # cc64, so warm the same concurrency buckets that the benchmark uses.
+        rows.update((6, 8, 16, 32, 64))
+    elif int(topk) == 2048 and int(num_heads) == 32:
+        # GLM shape: b12x fused route is currently selected through rows 16.
+        rows.update((6, 8, 16))
+    else:
+        # Generic route retains the small-row fused policy.
+        rows.add(6)
+
+    return tuple(sorted(rows))
+
