+        w6 = fshift(b, a, s2 + bits);
+        w5 = fshift(b, a, s2 + bits * 2);
+        w4 = fshift(b, a, s2 + bits * 3);
+        w3 = fshift(b, a, s2 + bits * 4);
+        w2 = fshift(b, a, s2 + bits * 5);
