+METRIC_KEYS = {"cold_us", "mean_us", "p50_us", "p95_us", "min_us", "max_us"}
+RANK_MODE_KEYS = METRIC_KEYS | {"samples_us"}
+CRITICAL_MODE_KEYS = METRIC_KEYS | {"samples_us"}
+GRAPH_STRUCTURE_KEYS = {
