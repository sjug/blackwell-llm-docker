+    dispose = dispose[: dispose.index("static int64_t meta_size()")]
+    assert dispose.index("fa->close_ipc_handles_strict();") < dispose.index(
+        "delete fa;"
+    )
+    assert "static bool dispose_best_effort(fptr_t _fa) noexcept" in dispose
