+]
+SUITE_TOP_LEVEL_KEYS = {
+    "schema",
+    "contract",
+    "controller",
+    "harness",
+    "implementations",
+    "sequence",
+    "records",
+    "paired_deltas",
+    "paired_summary",
+    "aggregate",
