+// Singleton to manage context for each device. Stores device attributes and a large-enough lock buffer per device
+class DevCtx
+{
+private:
+    int num_sms[MAX_DEVICES] = {};
+    int cc[MAX_DEVICES] = {};
+    void* locks[MAX_DEVICES] = {};
+    void* ws[MAX_DEVICES] = {};
+    std::mutex mtx;
