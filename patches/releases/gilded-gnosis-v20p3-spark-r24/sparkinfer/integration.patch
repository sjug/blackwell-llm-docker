+        w3 = fshift(b, a, s2 + bits * 4);
+        w2 = w3 >> bits;
+        w1 = fshift(b, a, s2 + bits * 6);
+        w0 = w1 >> bits;
+    }
+    if constexpr (align == 4)
+    {
