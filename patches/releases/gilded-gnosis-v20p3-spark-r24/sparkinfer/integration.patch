+template <int cb>
+__device__ inline half2 decode_3inst_2(uint32_t x0, uint32_t x1)
+{
+    if constexpr (cb == 0)
+    {
+        x0 *= 89226354u;
+        x1 *= 89226354u;
+        x0 += 64248484u;
+        x1 += 64248484u;
+        asm ("lop3.b32 %0, %0, 0x8fff8fff, 0x3b603b60, 0x6a;" : "+r"(x0));
+        asm ("lop3.b32 %0, %0, 0x8fff8fff, 0x3b603b60, 0x6a;" : "+r"(x1));
