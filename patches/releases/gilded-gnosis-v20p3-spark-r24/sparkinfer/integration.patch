+def _cuda_version(call: Callable[[], tuple[object, int]]) -> int:
+    result, version = call()
+    if result != cudart.cudaError_t.cudaSuccess:
+        raise RuntimeError(f"CUDA version query failed: {result}")
+    return int(version)
