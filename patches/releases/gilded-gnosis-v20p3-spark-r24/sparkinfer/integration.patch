+public:
+    static DevCtx& instance();
+    int get_num_sms(int device);
+    int get_cc(int device);
+    void* get_ws(int device);
+    int* get_locks(int device);
+
+private:
+    DevCtx() = default;
+    DevCtx(const DevCtx&) = delete;
+    DevCtx& operator=(const DevCtx&) = delete;
