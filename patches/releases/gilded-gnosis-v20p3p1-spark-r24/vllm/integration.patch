+        "PATH": os.environ["PATH"],
+        "HOME": str(tmp_path),
+        "XDG_CACHE_HOME": str(tmp_path / "cache"),
+        "DRY_RUN": "1",
+        "KV_OFFLOADING_SIZE": "five",
+    }
+    result = subprocess.run(
+        ["bash", str(_LAUNCHER)],
