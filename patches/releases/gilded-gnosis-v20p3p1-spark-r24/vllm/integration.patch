+def test_q_chunk_envelope_is_cached() -> None:
+    call_count = 0
+
+    def split_chunks_for_contract(**kwargs) -> int:
+        nonlocal call_count
+        call_count += 1
+        return min(kwargs["max_chunks"], 8 if kwargs["rows"] <= 256 else 1)
+
+    get_compressed_mla_max_q_chunks.cache_clear()
