+def _split_copy_descriptors_at_host_boundaries(
+    src: np.ndarray,
+    dst: np.ndarray,
+    sizes: np.ndarray,
+    count: int,
+    *,
+    host_is_src: bool,
+    host_base: int,
+    segment_bytes: int,
