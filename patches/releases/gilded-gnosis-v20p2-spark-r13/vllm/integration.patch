+    metadata = {
+        "format": "exl3-trellis",
+        "bits": 3.0,
+        "codebook": "mcg",
+        "experts_per_layer": 256,
+        "moe_layers": [3, 77],
+        "tensor_schema": (
+            "model.layers.{L}.mlp.experts.{E}.{proj}.rank{r}.{trellis|suh|svh|mcg}"
+        ),
+        "tp": 4,
+    }
+    metadata.update(overrides)
+    return metadata
