+def test_prepare_dflash_inputs_makes_context_graph_padding_inert():
+    device = torch.device("cuda")
+    max_num_reqs = 4
+    max_num_tokens = 16
+    num_reqs = 2
+    num_speculative_steps = 2
+    num_query_per_req = 3
+    num_context_tokens = 3
