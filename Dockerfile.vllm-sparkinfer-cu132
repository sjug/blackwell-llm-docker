FROM flashinfer-build AS deepgemm-build

SHELL ["/bin/bash", "-euxo", "pipefail", "-c"]

ARG DEEPGEMM_REPO
ARG DEEPGEMM_REF
ARG DEEPGEMM_COMMIT
ARG DEEPGEMM_PATCH_FILE
ARG DEEPGEMM_PATCH_SHA256

COPY patches /tmp/deepgemm-build-patches

RUN --mount=type=cache,target=/root/.ccache \
    git clone --recursive "${DEEPGEMM_REPO}" /tmp/deepgemm-src \
 && cd /tmp/deepgemm-src \
 && if [[ "${DEEPGEMM_REF}" =~ ^[0-9a-f]{40}$ ]]; then \
      git fetch --depth=1 origin "${DEEPGEMM_REF}"; \
      git checkout FETCH_HEAD; \
    elif [[ "${DEEPGEMM_REF}" == refs/* ]]; then \
      git fetch origin "${DEEPGEMM_REF}"; \
      git checkout FETCH_HEAD; \
    else \
      git checkout "${DEEPGEMM_REF}"; \
    fi \
 && if [[ -n "${DEEPGEMM_COMMIT}" ]]; then [[ "$(git rev-parse HEAD)" = "${DEEPGEMM_COMMIT}" ]] || { echo "ERROR: DEEPGEMM_COMMIT mismatch: HEAD=$(git rev-parse HEAD) expected=${DEEPGEMM_COMMIT}" >&2; exit 1; }; fi \
 && if [[ -n "${DEEPGEMM_PATCH_FILE}" ]]; then \
      if [[ -n "${DEEPGEMM_PATCH_SHA256}" ]]; then \
        echo "${DEEPGEMM_PATCH_SHA256}  /tmp/deepgemm-build-patches/${DEEPGEMM_PATCH_FILE}" | sha256sum -c -; \
      fi; \
      git apply --verbose "/tmp/deepgemm-build-patches/${DEEPGEMM_PATCH_FILE}" \
      && git diff --check; \
    fi \
 && git submodule update --init --recursive \
 && DG_FORCE_BUILD=1 DG_USE_LOCAL_VERSION=1 \
    python -m pip install --no-build-isolation --no-deps --force-reinstall . \
 && cd / \
 && python -c 'import importlib.metadata as md; import deep_gemm; print("deep_gemm", getattr(deep_gemm, "__version__", md.version("deep_gemm")))' \
 && rm -rf /tmp/deepgemm-src /tmp/deepgemm-build-patches

# =============================================================================
# Stage 2c: build B12X on top of cached FlashInfer/DeepGEMM.
# =============================================================================
FROM deepgemm-build AS b12x-build

SHELL ["/bin/bash", "-euxo", "pipefail", "-c"]

ARG B12X_REPO
ARG B12X_REF
ARG B12X_COMMIT
ARG B12X_PATCH_SHA256
ARG B12X_PATCH_FILE
ARG B12X_INTEGRATION_TREE

COPY patches /tmp/build-patches

RUN git clone --filter=blob:none "${B12X_REPO}" /tmp/b12x-src \
 && cd /tmp/b12x-src \
 && if [[ -n "${B12X_COMMIT}" ]]; then \
      git fetch origin "${B12X_COMMIT}"; \
      git checkout FETCH_HEAD; \
    elif [[ "${B12X_REF}" =~ ^[0-9a-f]{40}$ ]]; then \
      git fetch --depth=1 origin "${B12X_REF}"; \
      git checkout FETCH_HEAD; \
    elif [[ "${B12X_REF}" == refs/* ]]; then \
      git fetch origin "${B12X_REF}"; \
      git checkout FETCH_HEAD; \
    else \
      git checkout "${B12X_REF}"; \
    fi \
 && if [[ -n "${B12X_COMMIT}" ]]; then [[ "$(git rev-parse HEAD)" = "${B12X_COMMIT}" ]] || { echo "ERROR: B12X_COMMIT mismatch: HEAD=$(git rev-parse HEAD) expected=${B12X_COMMIT}" >&2; exit 1; }; fi \
 && if [[ -n "${B12X_PATCH_FILE}" ]]; then \
      b12x_patch="/tmp/build-patches/${B12X_PATCH_FILE}"; \
      [[ -f "${b12x_patch}" ]] || { echo "ERROR: B12X patch is missing: ${b12x_patch}" >&2; exit 1; }; \
      if [[ -n "${B12X_PATCH_SHA256}" ]]; then \
        echo "${B12X_PATCH_SHA256}  ${b12x_patch}" | sha256sum -c -; \
      fi; \
      git apply --verbose "${b12x_patch}"; \
      git diff --check; \
    fi \
 && if [[ -n "${B12X_INTEGRATION_TREE}" ]]; then \
      git add -A; \
      actual_tree="$(git write-tree)"; \
      [[ "${actual_tree}" == "${B12X_INTEGRATION_TREE}" ]] || { \
        echo "ERROR: composed B12X/SparkInfer tree mismatch: ${actual_tree} != ${B12X_INTEGRATION_TREE}" >&2; \
        exit 1; \
      }; \
    fi \
 && python -m pip install --no-deps --force-reinstall . \
 && rm -rf /tmp/b12x-src

# Runtime CUDA sources are JIT-compiled from the installed package. Fail the
# image build if a quoted local include was omitted from the wheel.
RUN python - <<'PY'
import re
import site
from pathlib import Path

roots = [
    Path(entry) / "sparkinfer" / "comm" / "pcie"
    for entry in site.getsitepackages()
    if (Path(entry) / "sparkinfer" / "comm" / "pcie").is_dir()
]
assert len(roots) == 1, roots
include_re = re.compile(r'^\s*#include\s+"([^"]+)"', re.MULTILINE)
for source in roots[0].glob("*.cu"):
    for include in include_re.findall(source.read_text(encoding="utf-8")):
        dependency = source.parent / include
        assert dependency.is_file(), f"{source.name} includes missing {include}"
PY

# =============================================================================
# Stage 2d: build vLLM on top of cached FlashInfer/DeepGEMM/B12X.
