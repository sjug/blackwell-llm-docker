    path = pathlib.Path(wheel)
    text = path.read_text()
    if "manylinux2014_sbsa" not in text:
        continue
    path.write_text(text.replace("manylinux2014_sbsa", "manylinux2014_aarch64"))
    data = path.read_bytes()
    digest = base64.urlsafe_b64encode(hashlib.sha256(data).digest()).rstrip(b"=").decode()
