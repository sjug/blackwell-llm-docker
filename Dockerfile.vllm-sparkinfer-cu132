FROM b12x-build AS vllm-build

SHELL ["/bin/bash", "-euxo", "pipefail", "-c"]

ARG VLLM_REPO
ARG VLLM_REF
ARG VLLM_COMMIT
ARG VLLM_PATCH_URL
ARG VLLM_PATCH_SHA256
ARG VLLM_PATCH_FILE
ARG VLLM_INTEGRATION_TREE
