ARG INSTANTTENSOR_COMMIT=

ARG LMCACHE_REPO=https://github.com/local-inference-lab/LMCache.git
ARG LMCACHE_REF=release/v0.5.2-glm52-dcp-base
ARG LMCACHE_COMMIT=9cebd405d0caf4bebe01d694b5a8bf4e3e354314
ARG LMCACHE_PATCH_FILE=
ARG LMCACHE_PATCH_SHA256=
ARG LMCACHE_BUILD_VERSION=0.5.2+glm52dcp.3

ARG XGRAMMAR_REPO=https://github.com/mlc-ai/xgrammar.git
ARG XGRAMMAR_REF=v0.2.5
ARG XGRAMMAR_COMMIT=2ea71da4ccb997a06928c9fb69b99f330da56697
ARG XGRAMMAR_VERSION=0.2.5
ARG XGRAMMAR_TRANSFORMERS5_COMPAT=1

ARG CUTLASS_REPO=https://github.com/NVIDIA/cutlass.git
ARG CUTLASS_REF=main
ARG CUTLASS_COMMIT=982cb9e718bcd4d7ac546b1795702a08326dfe4b
