ARG XGRAMMAR_VERSION
ARG XGRAMMAR_TRANSFORMERS5_COMPAT

COPY tests/verify_xgrammar_required_tools.py /tmp/build-tests/verify_xgrammar_required_tools.py

WORKDIR /build

RUN git clone --recursive --filter=blob:none "${VLLM_REPO}" /opt/vllm \
 && cd /opt/vllm \
 && if [[ -n "${VLLM_COMMIT}" ]]; then \
      git fetch origin "${VLLM_COMMIT}"; \
      git checkout FETCH_HEAD; \
    else \
      git checkout "${VLLM_REF}"; \
    fi \
 && if [[ -n "${VLLM_COMMIT}" ]]; then [[ "$(git rev-parse HEAD)" = "${VLLM_COMMIT}" ]] || { echo "ERROR: VLLM_COMMIT mismatch: HEAD=$(git rev-parse HEAD) expected=${VLLM_COMMIT}" >&2; exit 1; }; fi \
 && if [[ -n "${VLLM_PATCH_FILE}" ]]; then \
      vllm_patch="/tmp/build-patches/${VLLM_PATCH_FILE}"; \
      [[ -f "${vllm_patch}" ]] || { echo "ERROR: vLLM patch is missing: ${vllm_patch}" >&2; exit 1; }; \
      if [[ -n "${VLLM_PATCH_SHA256}" ]]; then \
        echo "${VLLM_PATCH_SHA256}  ${vllm_patch}" | sha256sum -c -; \
      fi; \
      git apply --verbose "${vllm_patch}"; \
      git diff --check; \
    fi \
 && if [[ -n "${VLLM_PATCH_URL}" ]]; then \
      curl -fsSL "${VLLM_PATCH_URL}" -o /tmp/vllm-extra.patch; \
      if [[ -n "${VLLM_PATCH_SHA256}" ]]; then \
        echo "${VLLM_PATCH_SHA256}  /tmp/vllm-extra.patch" | sha256sum -c -; \
      fi; \
      git apply --verbose /tmp/vllm-extra.patch; \
      git diff --check; \
    fi \
 && if [[ -n "${VLLM_INTEGRATION_TREE}" ]]; then \
      git add -A; \
      actual_tree="$(git write-tree)"; \
      [[ "${actual_tree}" == "${VLLM_INTEGRATION_TREE}" ]] || { \
        echo "ERROR: composed vLLM tree mismatch: ${actual_tree} != ${VLLM_INTEGRATION_TREE}" >&2; \
        exit 1; \
      }; \
    fi \
 && CUTLASS_DSL_VERSION="${CUTLASS_DSL_VERSION}" python - <<'PY'
import os
import re
from importlib.metadata import PackageNotFoundError, version

path = "requirements/cuda.txt"
text = open(path, encoding="utf-8").read()
versions = {}
for package in ("flashinfer-python", "flashinfer-cubin"):
    try:
        versions[package] = version(package)
    except PackageNotFoundError:
        text, count = re.subn(
            rf"^{re.escape(package)}==.*\n?",
            "",
            text,
            flags=re.MULTILINE,
        )
        if count:
            print(f"removed absent {package} pin from {path}")
        continue
for package, package_version in versions.items():
    text, count = re.subn(
        rf"^{re.escape(package)}==.*$",
        f"{package}=={package_version}",
        text,
        flags=re.MULTILINE,
    )
    if count != 1:
        raise SystemExit(
            f"expected exactly one {package} pin in {path}, found {count}")
cutlass_dsl_version = os.environ["CUTLASS_DSL_VERSION"]
text, count = re.subn(
    r"^nvidia-cutlass-dsl\[cu13\]==.*$",
    f"nvidia-cutlass-dsl[cu13]=={cutlass_dsl_version}",
    text,
    flags=re.MULTILINE,
)
if count != 1:
    raise SystemExit(
        f"expected exactly one nvidia-cutlass-dsl pin in {path}, found {count}")
open(path, "w", encoding="utf-8").write(text)
print("vLLM FlashInfer requirements:", versions)
print("vLLM CUTLASS DSL requirement:", cutlass_dsl_version)
PY

RUN cd /opt/vllm \
 && grep -v '^torch==' requirements/build/cuda.txt > /tmp/vllm-build-notorch.txt \
 && python -m pip install -r /tmp/vllm-build-notorch.txt \
 && python -m pip install -r requirements/common.txt \
 && python -m pip install "fastapi[standard]>=0.115.0,<0.137" \
 && python -m pip install setuptools_scm "setuptools-rust>=1.9.0" \
 && (python -m pip check || true)

RUN <<'SH'
set -euxo pipefail
if [[ -z "${XGRAMMAR_REF}" ]]; then
  echo "Using the xgrammar version supplied by vLLM requirements"
  exit 0
fi
[[ -n "${XGRAMMAR_COMMIT}" ]]
[[ -n "${XGRAMMAR_VERSION}" ]]
git clone --filter=blob:none "${XGRAMMAR_REPO}" /tmp/xgrammar-src
cd /tmp/xgrammar-src
if [[ "${XGRAMMAR_REF}" =~ ^[0-9a-f]{40}$ ]]; then
  git fetch --depth=1 origin "${XGRAMMAR_REF}"
  git checkout FETCH_HEAD
elif [[ "${XGRAMMAR_REF}" == refs/* ]]; then
  git fetch origin "${XGRAMMAR_REF}"
  git checkout FETCH_HEAD
else
  git checkout "${XGRAMMAR_REF}"
fi
actual_commit="$(git rev-parse HEAD)"
[[ "${actual_commit}" == "${XGRAMMAR_COMMIT}" ]] || {
  echo "ERROR: XGRAMMAR_COMMIT mismatch: HEAD=${actual_commit} expected=${XGRAMMAR_COMMIT}" >&2
  exit 1
}
git submodule update --init --recursive
if [[ "${XGRAMMAR_TRANSFORMERS5_COMPAT}" == "1" ]]; then
  # Upstream caps Transformers below 5 because several unrelated tokenizers
  # regress there. This GLM-only image validates its tokenizer against the
  # image's Transformers 5 runtime, so only relax that package-metadata cap.
  python - <<'PY'
from pathlib import Path

path = Path("pyproject.toml")
text = path.read_text()
needle = '  "transformers>=4.38.0,<5",'
replacement = '  "transformers>=4.38.0",'
assert text.count(needle) == 1, "unexpected xgrammar Transformers requirement"
path.write_text(text.replace(needle, replacement))
PY
elif [[ "${XGRAMMAR_TRANSFORMERS5_COMPAT}" != "0" ]]; then
  echo "ERROR: XGRAMMAR_TRANSFORMERS5_COMPAT must be 0 or 1" >&2
  exit 1
fi
python -m pip install --no-cache-dir "scikit-build-core>=0.10.0"
mkdir -p /tmp/xgrammar-wheels
SKBUILD_BUILD_DIR=/tmp/xgrammar-build \
  CMAKE_BUILD_PARALLEL_LEVEL="${VLLM_MAX_JOBS}" \
  python -m pip wheel --no-build-isolation --no-deps \
    -w /tmp/xgrammar-wheels /tmp/xgrammar-src
test "$(find /tmp/xgrammar-wheels -maxdepth 1 -name 'xgrammar-*.whl' | wc -l)" -eq 1
python -m pip install --no-deps --force-reinstall \
  /tmp/xgrammar-wheels/xgrammar-*.whl
printf '%s\n' "${XGRAMMAR_VERSION}" > /opt/venv/.xgrammar-version
python /tmp/build-tests/verify_xgrammar_required_tools.py \
  --expected-version "${XGRAMMAR_VERSION}"
SH

WORKDIR /opt/vllm

RUN apt-get update \
 && apt-get install -y --no-install-recommends libprotobuf-dev protobuf-compiler \
 && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain none \
 && . /root/.cargo/env \
 && rust_toolchain="$(grep '^channel' rust-toolchain.toml | sed 's/.*= *"\(.*\)"/\1/')" \
 && rustup toolchain install "${rust_toolchain}" \
 && rustup default "${rust_toolchain}" \
 && cargo --version \
 && rustc --version

RUN if [[ -f use_existing_torch.py ]]; then python use_existing_torch.py; fi

RUN if [[ -n "${TRITON_KERNELS_REF}" ]]; then \
      git clone --filter=blob:none "${TRITON_KERNELS_REPO}" /build/triton; \
      cd /build/triton; \
      git checkout "${TRITON_KERNELS_REF}"; \
      if [[ -n "${TRITON_KERNELS_COMMIT}" ]]; then [[ "$(git rev-parse HEAD)" = "${TRITON_KERNELS_COMMIT}" ]] || { echo "ERROR: TRITON_KERNELS_COMMIT mismatch: HEAD=$(git rev-parse HEAD) expected=${TRITON_KERNELS_COMMIT}" >&2; exit 1; }; fi; \
