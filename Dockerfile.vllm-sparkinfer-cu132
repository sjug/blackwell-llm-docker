ARG TVM_FFI_VERSION=0.1.9

ARG TRITON_KERNELS_REPO=https://github.com/triton-lang/triton.git
ARG TRITON_KERNELS_REF=
ARG TRITON_KERNELS_COMMIT=

ARG MAX_JOBS=128
ARG NVCC_THREADS=1
ARG VLLM_MAX_JOBS=128
ARG VLLM_NVCC_THREADS=1

# CUDA target architectures. Defaults match the historical SM120 (RTX PRO 6000
# Blackwell) x86_64 build. For GB10 / DGX Spark (SM121, aarch64) pass:
#   TORCH_CUDA_ARCH_LIST_ARG=12.1a
#   CMAKE_CUDA_ARCHITECTURES_ARG=121a
#   FLASHINFER_CUDA_ARCH_LIST_ARG=12.1a
#   PLAIN_CUDA_ARCH_LIST_ARG=12.1
# FlashInfer builds a separate cubin per SM12x variant on purpose (it refuses
# to run SM120 cubins on SM121), and its sm121 AOT modules are only enabled
# when 12.1a is in the arch list — do not reuse 12.0f for a GB10 build.
# PLAIN_CUDA_ARCH_LIST_ARG feeds the suffix-less LMCache wheel build; the
# EXL3 extension inherits the suffixed TORCH_CUDA_ARCH_LIST from the base
# stage ENV.
ARG TORCH_CUDA_ARCH_LIST_ARG=12.0a
ARG CMAKE_CUDA_ARCHITECTURES_ARG=120a
ARG FLASHINFER_CUDA_ARCH_LIST_ARG=12.0f
ARG PLAIN_CUDA_ARCH_LIST_ARG=12.0

# =============================================================================
# Stage 0: patched NCCL
# =============================================================================
FROM nvidia/cuda:${CUDA_VERSION}-cudnn-devel-ubuntu${UBUNTU_VERSION} AS nccl-build

ARG NCCL_REPO
ARG NCCL_REF
ARG NCCL_COMMIT
ARG DEBIAN_FRONTEND=noninteractive

SHELL ["/bin/bash", "-euxo", "pipefail", "-c"]

RUN for attempt in {1..5}; do \
      if apt-get update; then break; fi; \
      if [[ "${attempt}" == "5" ]]; then exit 1; fi; \
      rm -rf /var/lib/apt/lists/*; \
      sleep $((attempt * 10)); \
    done \
    && apt-get install -y --no-install-recommends \
    git \
    python3 \
    build-essential \
    make \
    g++ \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN git clone "${NCCL_REPO}" nccl \
 && cd nccl \
 && git checkout "${NCCL_REF}" \
 && if [[ -n "${NCCL_COMMIT}" ]]; then [[ "$(git rev-parse HEAD)" = "${NCCL_COMMIT}" ]] || { echo "ERROR: NCCL_COMMIT mismatch: HEAD=$(git rev-parse HEAD) expected=${NCCL_COMMIT}" >&2; exit 1; }; fi \
 && make -j"$(nproc)" src.build CUDA_HOME=/usr/local/cuda \
 && strings "build/lib/libnccl.so.2.30.4" | grep -F "NCCL version 2.30.4 compiled with CUDA 13.2"

# =============================================================================
# Stage 1: reusable CUDA/Python/NCCL system base
# =============================================================================
FROM nvidia/cuda:${CUDA_VERSION}-cudnn-devel-ubuntu${UBUNTU_VERSION} AS vllm-b12x-cu132-system-base-build

ARG PYTHON_VERSION
ARG NCCL_SONAME
ARG CUBLAS_CUDA13_VERSION
ARG CUDNN_CUDA13_VERSION
ARG CUDA_COMPAT_13_2_VERSION
ARG DEBIAN_FRONTEND=noninteractive

SHELL ["/bin/bash", "-euxo", "pipefail", "-c"]

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Keep the toolkit on 13.2.1, but overlay the latest CUDA 13 libraries NVIDIA
# publishes for Ubuntu 24.04 without pulling CUDA 13.3 packages.
RUN for attempt in {1..5}; do \
      if apt-get update; then break; fi; \
      if [[ "${attempt}" == "5" ]]; then exit 1; fi; \
      rm -rf /var/lib/apt/lists/*; \
      sleep $((attempt * 10)); \
    done \
    && apt-get install -y --allow-change-held-packages --no-install-recommends \
    python${PYTHON_VERSION} \
    python${PYTHON_VERSION}-dev \
    python${PYTHON_VERSION}-venv \
    python3-pip \
    git \
    git-lfs \
    wget \
    curl \
    ca-certificates \
    build-essential \
    cmake \
    ninja-build \
    ccache \
    libprotobuf-dev \
    protobuf-compiler \
    pkg-config \
    patchelf \
    libssl-dev \
    libffi-dev \
    libjpeg-dev \
    libpng-dev \
    libgomp1 \
    numactl \
    libnuma-dev \
    libibverbs-dev \
    pciutils \
    cuda-compat-13-2=${CUDA_COMPAT_13_2_VERSION} \
    libcublas13-cuda-13=${CUBLAS_CUDA13_VERSION} \
    libcublas13-dev-cuda-13=${CUBLAS_CUDA13_VERSION} \
    cublas-cuda-13=${CUBLAS_CUDA13_VERSION} \
    libcudnn9-cuda-13=${CUDNN_CUDA13_VERSION} \
    libcudnn9-dev-cuda-13=${CUDNN_CUDA13_VERSION} \
    libcudnn9-headers-cuda-13=${CUDNN_CUDA13_VERSION} \
    libcudnn9-static-cuda-13=${CUDNN_CUDA13_VERSION} \
    && ldconfig \
    && rm -rf /var/lib/apt/lists/*

RUN multiarch="$(uname -m)-linux-gnu" \
 && cuda_target="$(basename "$(ls -d /usr/local/cuda/targets/*-linux | head -1)")" \
 && cublas="$(readlink -f /usr/lib/${multiarch}/libcublas/13/libcublas.so.13)" \
 && cublas_lt="$(readlink -f /usr/lib/${multiarch}/libcublas/13/libcublasLt.so.13)" \
 && cublas_name="$(basename "${cublas}")" \
 && cublas_lt_name="$(basename "${cublas_lt}")" \
 && test -f "${cublas}" \
 && test -f "${cublas_lt}" \
 && for cuda_libdir in /usr/local/cuda/targets/${cuda_target}/lib /usr/local/cuda-${CUDA_VERSION}/targets/${cuda_target}/lib; do \
      if [[ -d "${cuda_libdir}" ]]; then \
        cuda_libdir="$(readlink -f "${cuda_libdir}")"; \
        rm -f "${cuda_libdir}"/libcublas.so "${cuda_libdir}"/libcublas.so.13 "${cuda_libdir}"/libcublas.so.13.*; \
        rm -f "${cuda_libdir}"/libcublasLt.so "${cuda_libdir}"/libcublasLt.so.13 "${cuda_libdir}"/libcublasLt.so.13.*; \
        ln -s "${cublas}" "${cuda_libdir}/${cublas_name}"; \
        ln -s "${cublas_name}" "${cuda_libdir}/libcublas.so.13"; \
        ln -s libcublas.so.13 "${cuda_libdir}/libcublas.so"; \
        ln -s "${cublas_lt}" "${cuda_libdir}/${cublas_lt_name}"; \
        ln -s "${cublas_lt_name}" "${cuda_libdir}/libcublasLt.so.13"; \
        ln -s libcublasLt.so.13 "${cuda_libdir}/libcublasLt.so"; \
      fi; \
    done \
 && ldconfig

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python${PYTHON_VERSION} 1 \
 && update-alternatives --install /usr/bin/python python /usr/bin/python${PYTHON_VERSION} 1

COPY --from=nccl-build /build/nccl/build/lib/${NCCL_SONAME} /opt/libnccl-local-inference.so.2.30.4

ENV NCCL_LOCAL_INFERENCE_PATH=/opt/libnccl-local-inference.so.2.30.4 \
    NCCL_PR2127_PATH=/opt/libnccl-local-inference.so.2.30.4 \
    VLLM_NCCL_SO_PATH=/opt/libnccl-local-inference.so.2.30.4

LABEL org.opencontainers.image.description="Reusable CUDA 13.2.1 vLLM+B12X system base with latest CUDA 13.2-compatible cuBLAS/cuDNN overlays and patched NCCL 2.30.4" \
      local-inference.cuda.version="13.2.1" \
      local-inference.cuda.compat.version="${CUDA_COMPAT_13_2_VERSION}" \
      local-inference.cublas.version="${CUBLAS_CUDA13_VERSION}" \
      local-inference.cudnn.version="${CUDNN_CUDA13_VERSION}" \
      local-inference.nccl.repo="local-inference-lab/nccl-canonical" \
      local-inference.nccl.branch="canonical/cu132-nccl2304-amd-noxml" \
      local-inference.nccl.version="2.30.4"

# =============================================================================
# Stage 1b: reusable PyTorch/CUTLASS build base
# =============================================================================
FROM ${VLLM_B12X_CU132_SYSTEM_BASE_IMAGE} AS vllm-b12x-cu132-build-base-build

ARG CUTLASS_DSL_VERSION

SHELL ["/bin/bash", "-euxo", "pipefail", "-c"]

RUN python -m venv /opt/venv

ENV VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}"

RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --upgrade "pip<26" setuptools wheel \
 && python -m pip install \
      --index-url https://download.pytorch.org/whl/cu132 \
      --extra-index-url https://pypi.org/simple \
      "torch==2.12.0+cu132" \
      "torchvision==0.27.0+cu132" \
 && python -m pip install \
      "cuda-tile>=1.4.0" \
      nvidia-cuda-tileiras==13.2.78 \
      "nvidia-cutlass-dsl[cu13]==${CUTLASS_DSL_VERSION}" \
 && python -m pip install --force-reinstall --no-deps \
      "nvidia-cutlass-dsl-libs-cu13==${CUTLASS_DSL_VERSION}"

# NVIDIA aarch64 wheels (e.g. nvidia-cusparselt-cu13) record the nonstandard
# platform tag manylinux2014_sbsa in their dist-info WHEEL metadata; pip >= 25
# treats that as "not supported on this platform" in pip check. Normalize the
# tag (and its RECORD hash) to the real aarch64 tag. No-op on x86_64.
RUN python - <<'FIXSBSA'
import base64, csv, glob, hashlib, io, pathlib

for wheel in glob.glob("/opt/venv/lib/python*/site-packages/*.dist-info/WHEEL"):
    path = pathlib.Path(wheel)
    text = path.read_text()
    if "manylinux2014_sbsa" not in text:
        continue
    path.write_text(text.replace("manylinux2014_sbsa", "manylinux2014_aarch64"))
    data = path.read_bytes()
    digest = base64.urlsafe_b64encode(hashlib.sha256(data).digest()).rstrip(b"=").decode()
    record_path = path.parent / "RECORD"
    rows = list(csv.reader(io.StringIO(record_path.read_text())))
    for row in rows:
        if row and row[0].endswith(".dist-info/WHEEL"):
            row[1] = f"sha256={digest}"
            row[2] = str(len(data))
    out = io.StringIO()
    csv.writer(out, lineterminator="\n").writerows(rows)
    record_path.write_text(out.getvalue())
    print(f"normalized sbsa platform tag: {wheel}")
FIXSBSA

RUN python -m pip check

RUN torch_nccl=/opt/venv/lib/python3.12/site-packages/nvidia/nccl/lib/libnccl.so.2 \
 && local_nccl=/opt/libnccl-local-inference.so.2.30.4 \
 && normal_nccl=/opt/libnccl.so.2.30.4 \
 && test -e "${torch_nccl}" \
 && test -e "${local_nccl}" \
 && if [[ ! -e "${normal_nccl}" ]]; then cp -aL "${local_nccl}" "${normal_nccl}"; fi \
 && if [[ ! -e "${local_nccl}.orig" ]]; then cp -aL "${local_nccl}" "${local_nccl}.orig"; fi \
 && if [[ ! -e "${torch_nccl}.torch-bundled-2.29.7" ]]; then cp -aL "${torch_nccl}" "${torch_nccl}.torch-bundled-2.29.7"; fi \
 && readelf -d "${normal_nccl}" | grep -F 'Library soname: [libnccl.so.2]' \
 && ln -sfn "${normal_nccl}" "${local_nccl}" \
 && ln -sfn "${normal_nccl}" /opt/libnccl.so.2 \
 && ln -sfn "${normal_nccl}" "${torch_nccl}" \
 && ldconfig \
 && python - <<'PY'
import torch

paths = []
with open("/proc/self/maps", encoding="utf-8") as maps:
    for line in maps:
        if "libnccl" in line:
            paths.append(line.split()[-1])

unique = sorted(set(paths))
print("torch nccl api", torch.cuda.nccl.version())
print("mapped libnccl paths", unique)
assert unique == ["/opt/libnccl.so.2.30.4"], unique
PY

RUN python - <<'PY'
import torch
print("torch", torch.__version__)
print("torch cuda", torch.version.cuda)
print("torch nccl", torch.cuda.nccl.version())
assert torch.__version__.startswith("2.12.0+cu132")
assert torch.version.cuda == "13.2"
PY

ARG TORCH_CUDA_ARCH_LIST_ARG
ARG CMAKE_CUDA_ARCHITECTURES_ARG
ARG FLASHINFER_CUDA_ARCH_LIST_ARG

ENV CCACHE_DIR=/root/.ccache \
    CMAKE_C_COMPILER_LAUNCHER=ccache \
    CMAKE_CXX_COMPILER_LAUNCHER=ccache \
    CMAKE_CUDA_COMPILER_LAUNCHER=ccache \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST_ARG} \
    CMAKE_CUDA_ARCHITECTURES=${CMAKE_CUDA_ARCHITECTURES_ARG} \
    FLASHINFER_CUDA_ARCH_LIST=${FLASHINFER_CUDA_ARCH_LIST_ARG} \
    FLASHINFER_LOCAL_VERSION=cu132 \
    FLASHINFER_NVCC_THREADS=1 \
    FLASHINFER_DISABLE_VERSION_CHECK=1 \
    AOT_MAX_JOBS_CAP=8

LABEL org.opencontainers.image.description="Reusable CUDA 13.2.1 vLLM+B12X build base with PyTorch 2.12 cu132 and CUTLASS DSL" \
      local-inference.torch.version="2.12.0+cu132" \
      local-inference.cutlass_dsl.version="${CUTLASS_DSL_VERSION}"

# =============================================================================
# Stage 1c: build settings overlay
# =============================================================================
FROM ${VLLM_B12X_CU132_BUILD_BASE_IMAGE} AS base

ARG MAX_JOBS
ARG NVCC_THREADS
ARG CUTLASS_DSL_VERSION

SHELL ["/bin/bash", "-euxo", "pipefail", "-c"]

ENV MAX_JOBS=${MAX_JOBS} \
    NVCC_THREADS=${NVCC_THREADS}

# The reusable build base remains pinned for old image recipes. Upgrade it in
# this derived stage when a newer vLLM revision requires a newer CuTe DSL.
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --upgrade \
      "nvidia-cutlass-dsl[cu13]==${CUTLASS_DSL_VERSION}" \
 && python -m pip install --force-reinstall --no-deps \
      "nvidia-cutlass-dsl-libs-cu13==${CUTLASS_DSL_VERSION}" \
 && python -m pip check

# CUDA 13.x headers can be laid out under cccl/. Keep both old and new include
# paths usable for third-party build scripts.
RUN cuda_target="$(basename "$(ls -d /usr/local/cuda/targets/*-linux | head -1)")" \
 && if [[ -d /usr/local/cuda/targets/${cuda_target}/include/cccl/cuda && ! -e /usr/local/cuda/include/cuda ]]; then \
      ln -sf /usr/local/cuda/targets/${cuda_target}/include/cccl/cuda /usr/local/cuda/include/cuda; \
    fi

# =============================================================================
# Stage 2a: build the public SM120 EXL3 extension against this image's exact
# PyTorch/CUDA ABI. This avoids the opaque prebuilt binary and ABI shim used by
# the original standalone EXL3 image.
# =============================================================================
FROM base AS exllamav3-build

# Re-declare SHELL: the OCI image format does not persist it across stage
# boundaries (podman/buildah), unlike docker-format BuildKit builds.
SHELL ["/bin/bash", "-euxo", "pipefail", "-c"]

ARG EXLLAMAV3_REPO
ARG EXLLAMAV3_REF
ARG EXLLAMAV3_COMMIT
# SKIP_EXLLAMAV3=1 produces an empty /opt/exllamav3 with a SKIPPED marker
# instead of building the extension. The a1-retile-sm120 tree hard-requires
# x86 (immintrin.h, __builtin_cpu_supports, AVX CPU-reduce sources that also
# carry the scalar fallback), so it cannot currently build on aarch64/GB10.
# The EXL3/TR3 quant path is not served on the Spark fleet; the deviation is
# recorded in the local-inference.exllamav3.skipped image label.
ARG SKIP_EXLLAMAV3=0

WORKDIR /build

RUN if [[ "${SKIP_EXLLAMAV3}" == "1" ]]; then \
      install -d /opt/exllamav3 /opt/exllamav3-python; \
      printf 'exllamav3 %s (%s) deliberately not built for SM121/aarch64: 2026-08-04 spike compiled all units behind x86 arch guards, but the encoder and standalone decode op disagree by whole codewords for the 3INST and MCG codebooks on sm_121a (mul1 is bit-exact); deferred pending kernel-level root cause\n' \
        "${EXLLAMAV3_COMMIT}" "${EXLLAMAV3_REF}" > /opt/exllamav3/SKIPPED; \
      cp /opt/exllamav3/SKIPPED /opt/exllamav3-python/SKIPPED; \
    else \
      git clone "${EXLLAMAV3_REPO}" exllamav3 \
      && cd exllamav3 \
      && git checkout "${EXLLAMAV3_REF}" \
      && { [[ "$(git rev-parse HEAD)" = "${EXLLAMAV3_COMMIT}" ]] || { \
           echo "ERROR: EXLLAMAV3_COMMIT mismatch: HEAD=$(git rev-parse HEAD) expected=${EXLLAMAV3_COMMIT}" >&2; \
           exit 1; \
         }; } \
      && TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} MAX_JOBS="${MAX_JOBS}" \
           python setup.py build_ext --inplace \
      && mapfile -t extensions < <(find . -maxdepth 1 -type f -name 'exllamav3_ext*.so' -print) \
      && [[ "${#extensions[@]}" == 1 ]] \
      && install -d /opt/exllamav3 \
      && install -m 0755 "${extensions[0]}" /opt/exllamav3/ \
      && test -f exllamav3/modules/quant/exl3_lib/quantize.py \
      && install -d /opt/exllamav3-python \
      && cp -a exllamav3 /opt/exllamav3-python/; \
    fi

RUN if [[ "${SKIP_EXLLAMAV3}" == "1" ]]; then \
      test -f /opt/exllamav3/SKIPPED; \
      echo "EXL3 extension: SKIPPED"; \
      exit 0; \
    fi \
 && VLLM_EXL3_EXT_PATH=/opt/exllamav3 python - <<'PY'
import importlib
import os
import sys

import torch  # Load the Torch runtime and libc10 before the extension.

sys.path.insert(0, os.environ["VLLM_EXL3_EXT_PATH"])
ext = importlib.import_module("exllamav3_ext")
required = (
    "exl3_gemm",
    "exl3_moe_fused",
    "exl3_moe_fused_retile",
    "exl3_moe_max_concurrency",
)
missing = [name for name in required if not hasattr(ext, name)]
assert not missing, f"EXL3 extension is missing exports: {missing}"
print("EXL3 extension source build: PASS")
PY

# =============================================================================
# Stage 2b: build FlashInfer and flashinfer-cubin.
#
# Keep this stage independent from vLLM args so local BuildKit cache reuses the
# expensive FlashInfer/CUBIN build until CUDA/Torch/CUTLASS/FlashInfer changes.
# =============================================================================
FROM base AS flashinfer-build

SHELL ["/bin/bash", "-euxo", "pipefail", "-c"]

ARG FLASHINFER_REPO
ARG FLASHINFER_REF
ARG FLASHINFER_COMMIT
ARG FLASHINFER_BUILD_CUBIN=1
ARG CUTLASS_REPO
ARG CUTLASS_REF
ARG CUTLASS_COMMIT

WORKDIR /build

RUN if [[ "${CUTLASS_REF}" =~ ^[0-9a-f]{40}$ ]]; then \
      git clone --filter=blob:none "${CUTLASS_REPO}" /build/cutlass; \
      cd /build/cutlass; \
      git checkout "${CUTLASS_REF}"; \
    else \
      git clone --depth 1 --branch "${CUTLASS_REF}" "${CUTLASS_REPO}" /build/cutlass; \
      cd /build/cutlass; \
    fi \
 && if [[ -n "${CUTLASS_COMMIT}" ]]; then [[ "$(git rev-parse HEAD)" = "${CUTLASS_COMMIT}" ]] || { echo "ERROR: CUTLASS_COMMIT mismatch: HEAD=$(git rev-parse HEAD) expected=${CUTLASS_COMMIT}" >&2; exit 1; }; fi \
 && grep "CUTLASS_MAJOR\\|CUTLASS_MINOR\\|CUTLASS_PATCH" include/cutlass/version.h | head -3

RUN CUTLASS_DSL="$(python -c 'import cutlass.utils.blockscaled_layout as m; print(m.__file__)')" \
 && cp /build/cutlass/python/CuTeDSL/cutlass/utils/blockscaled_layout.py "${CUTLASS_DSL}" \
 && python -c 'from cutlass.utils.blockscaled_layout import sm120_make_smem_layout_sfa; print("OK: sm120_make_smem_layout_sfa available")'

# Pin build-stage tvm-ffi to the runtime version: downstream stages (the
# XGrammar source build in particular) link native bindings against
# whatever libtvm_ffi is present here, while the final stage installs
# apache-tvm-ffi==TVM_FFI_VERSION. The upstream ">=0.1.6" floats to the
# newest release, which produced xgrammar bindings importing
# TVMFFIGetCustomAllocator (0.1.13 ABI) that the 0.1.10 runtime lacks.
ARG TVM_FFI_VERSION
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install \
      "apache-tvm-ffi==${TVM_FFI_VERSION}" \
      "nvidia-cudnn-frontend>=1.13.0" \
      packaging \
      pynvml \
      nvidia-ml-py \
      requests \
      numpy \
      einops \
      click \
      tabulate \
      tqdm

COPY .tmp-flashinfer-wheels/ /tmp/prebuilt-flashinfer-wheels/

RUN --mount=type=cache,target=/root/.ccache \
    if compgen -G "/tmp/prebuilt-flashinfer-wheels/flashinfer_python-*.whl" >/dev/null; then \
      ls -lh /tmp/prebuilt-flashinfer-wheels; \
      (python -m pip uninstall -y flashinfer-python flashinfer-cubin flashinfer-jit-cache || true); \
      shopt -s nullglob; \
      wheels=(/tmp/prebuilt-flashinfer-wheels/flashinfer_python-*.whl \
        /tmp/prebuilt-flashinfer-wheels/flashinfer_cubin-*.whl \
        /tmp/prebuilt-flashinfer-wheels/flashinfer_jit_cache-*.whl); \
      python -m pip install --no-deps --force-reinstall "${wheels[@]}"; \
    else \
      git clone --recursive "${FLASHINFER_REPO}" /tmp/flashinfer-src; \
      cd /tmp/flashinfer-src; \
      if [[ "${FLASHINFER_REF}" =~ ^[0-9a-f]{40}$ ]]; then \
        git fetch --depth=1 origin "${FLASHINFER_REF}"; \
        git checkout FETCH_HEAD; \
      elif [[ "${FLASHINFER_REF}" == refs/* ]]; then \
        git fetch origin "${FLASHINFER_REF}"; \
        git checkout FETCH_HEAD; \
      else \
        git checkout "${FLASHINFER_REF}"; \
      fi; \
      if [[ -n "${FLASHINFER_COMMIT}" ]]; then [[ "$(git rev-parse HEAD)" = "${FLASHINFER_COMMIT}" ]] || { echo "ERROR: FLASHINFER_COMMIT mismatch: HEAD=$(git rev-parse HEAD) expected=${FLASHINFER_COMMIT}" >&2; exit 1; }; fi; \
      git submodule update --init --recursive; \
      (python -m pip uninstall -y flashinfer-python flashinfer-cubin flashinfer-jit-cache || true); \
      FLASHINFER_CUDA_ARCH_LIST="${FLASHINFER_CUDA_ARCH_LIST}" \
        FLASHINFER_ENABLE_SM90=0 \
        MAX_JOBS="${MAX_JOBS}" \
        python -m pip install --no-build-isolation --no-deps -v .; \
      if [[ "${FLASHINFER_BUILD_CUBIN}" == "1" ]] && FLASHINFER_CUDA_ARCH_LIST="${FLASHINFER_CUDA_ARCH_LIST}" \
        MAX_JOBS="${MAX_JOBS}" \
        python -m pip wheel --no-build-isolation --no-deps -w /tmp/flashinfer-wheels ./flashinfer-cubin; then \
        python -m pip install --no-deps --force-reinstall /tmp/flashinfer-wheels/flashinfer_cubin-*.whl; \
      else \
        echo "WARNING: flashinfer-cubin wheel build skipped or failed; continuing with flashinfer-python + flashinfer-jit-cache"; \
      fi; \
      FLASHINFER_CUDA_ARCH_LIST="${FLASHINFER_CUDA_ARCH_LIST}" \
        MAX_JOBS="${MAX_JOBS}" \
        python -m pip wheel --no-build-isolation --no-deps -w /tmp/flashinfer-wheels ./flashinfer-jit-cache; \
      python -m pip install --no-deps --force-reinstall /tmp/flashinfer-wheels/flashinfer_jit_cache-*.whl; \
    fi \
 && python -c 'import flashinfer; print("flashinfer", getattr(flashinfer, "__version__", "unknown"))'

# =============================================================================
